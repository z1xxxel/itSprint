          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/seasons/current?actorId={{empId}}", "host": ["{{baseUrl}}"], "path": ["api", "seasons", "current"], "query": [{ "key": "actorId", "value": "{{empId}}" }] }
          }
        },
        {
          "name": "5. Admin Changes Role & Blocks",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('baseUrl') + '/api/users/' + pm.collectionVariables.get('empId') + '/role?role=ORGANIZER&actorId=' + pm.collectionVariables.get('adminId'),",
                  "  method: 'PUT'",
                  "}, (err, res) => {",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/api/users/' + pm.collectionVariables.get('empId') + '/block?actorId=' + pm.collectionVariables.get('adminId'),",

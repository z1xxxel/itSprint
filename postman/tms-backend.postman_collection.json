{
  "info": {
    "name": "TMS Backend — Auto Tests",
    "description": "Автотесты для TMS Backend. Запускать по порядку. Папка 07 (Completion) требует ожидания ~40с — либо run all, либо вручную после паузы.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "00. Health check",
      "item": [
        {
          "name": "Ping",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('App is up', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        }
      ]
    },
    {
      "name": "01. Users",
      "item": [
        {
          "name": "Create ADMIN",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('adminEmail', 'admin-' + Date.now() + '@tms.local');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('adminId', b.id);",
                  "pm.test('role=ADMIN', () => pm.expect(b.role).to.eql('ADMIN'));",
                  "pm.test('password not returned', () => pm.expect(b).to.not.have.property('password'));",
                  "pm.test('balance=10000', () => pm.expect(parseFloat(b.balance)).to.eql(10000));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"admin123\",\n  \"role\": \"ADMIN\",\n  \"balance\": 10000\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "Create HR",
          "event": [
            { "listen": "prerequest", "script": { "exec": ["pm.collectionVariables.set('hrEmail', 'hr-' + Date.now() + '@tms.local');"] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.collectionVariables.set('hrId', b.id);",
              "pm.test('role=HR', () => pm.expect(b.role).to.eql('HR'));"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"HR Olga\",\n  \"email\": \"{{hrEmail}}\",\n  \"password\": \"hr12345\",\n  \"role\": \"HR\",\n  \"balance\": 1000\n}" },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "Create ORGANIZER",
          "event": [
            { "listen": "prerequest", "script": { "exec": ["pm.collectionVariables.set('orgEmail', 'org-' + Date.now() + '@tms.local');"] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.collectionVariables.set('organizerId', b.id);",
              "pm.test('role=ORGANIZER', () => pm.expect(b.role).to.eql('ORGANIZER'));"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ivan Organizer\",\n  \"email\": \"{{orgEmail}}\",\n  \"password\": \"ivan123\",\n  \"role\": \"ORGANIZER\",\n  \"balance\": 500\n}" },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "Create EMPLOYEE",
          "event": [
            { "listen": "prerequest", "script": { "exec": ["pm.collectionVariables.set('empEmail', 'emp-' + Date.now() + '@tms.local');"] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.collectionVariables.set('employeeId', b.id);",
              "pm.test('role=EMPLOYEE', () => pm.expect(b.role).to.eql('EMPLOYEE'));",
              "pm.test('initial balance=0', () => pm.expect(parseFloat(b.balance)).to.eql(0));"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Maria Employee\",\n  \"email\": \"{{empEmail}}\",\n  \"password\": \"maria123\",\n  \"role\": \"EMPLOYEE\",\n  \"balance\": 0\n}" },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "Create MANAGER",
          "event": [
            { "listen": "prerequest", "script": { "exec": ["pm.collectionVariables.set('mgrEmail', 'mgr-' + Date.now() + '@tms.local');"] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.collectionVariables.set('managerId', b.id);",
              "pm.test('role=MANAGER', () => pm.expect(b.role).to.eql('MANAGER'));"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Petr Manager\",\n  \"email\": \"{{mgrEmail}}\",\n  \"password\": \"petr123\",\n  \"role\": \"MANAGER\",\n  \"balance\": 2000\n}" },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "Duplicate email → 400",
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('400 on duplicate', () => pm.response.to.have.status(400));"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Dup\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"x1234567\",\n  \"role\": \"EMPLOYEE\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        }
      ]
    },
    {
      "name": "02. Events — Permissions",
      "item": [
        {
          "name": "Create event (ORGANIZER)",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const now = Date.now();",
              "const fmt = (ms) => new Date(ms).toISOString().slice(0, 19);",
              "pm.collectionVariables.set('fromTime', fmt(now + 3600000));",
              "pm.collectionVariables.set('toTime', fmt(now + 7200000));"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.collectionVariables.set('eventId', b.id);",
              "pm.test('status=NEW', () => pm.expect(b.eventStatus).to.eql('NEW'));",
              "pm.test('rewardsGranted=false', () => pm.expect(b.rewardsGranted).to.be.false);",
              "pm.test('paidInCoins=true', () => pm.expect(b.paidInCoins).to.be.true);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"organizerId\": {{organizerId}},\n  \"fromTime\": \"{{fromTime}}\",\n  \"toTime\": \"{{toTime}}\",\n  \"category\": \"IT\",\n  \"nameEvent\": \"Spring Boot Workshop\",\n  \"description\": \"Demo event\",\n  \"eventPlace\": \"Moscow\",\n  \"commentToAdmin\": \"Approve please\",\n  \"paidInCoins\": true,\n  \"rewardCoins\": 100.00,\n  \"rewardRating\": 5.0\n}" },
            "url": { "raw": "{{baseUrl}}/api/events", "host": ["{{baseUrl}}"], "path": ["api", "events"] }
          }
        },
        {
          "name": "Assign as EMPLOYEE → 403",
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('403 forbidden', () => pm.response.to.have.status(403));"
            ] } }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"actorId\": {{employeeId}}\n}" },
            "url": { "raw": "{{baseUrl}}/api/events/{{eventId}}/assign", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{eventId}}", "assign"] }
          }
        },
        {
          "name": "Assign as ORGANIZER → 403",
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('403 forbidden (ORGANIZER has no EVENT_APPROVE)', () => pm.response.to.have.status(403));"
            ] } }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"actorId\": {{organizerId}}\n}" },
            "url": { "raw": "{{baseUrl}}/api/events/{{eventId}}/assign", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{eventId}}", "assign"] }
          }
        },
        {
          "name": "Assign as HR → 200",
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('status=ASSIGNED', () => pm.expect(b.eventStatus).to.eql('ASSIGNED'));"
            ] } }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"actorId\": {{hrId}}\n}" },
            "url": { "raw": "{{baseUrl}}/api/events/{{eventId}}/assign", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{eventId}}", "assign"] }
          }
        },
        {
          "name": "Assign again → 400",
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('400 already ASSIGNED', () => pm.response.to.have.status(400));"
            ] } }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"actorId\": {{hrId}}\n}" },
            "url": { "raw": "{{baseUrl}}/api/events/{{eventId}}/assign", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{eventId}}", "assign"] }
          }
        },
        {
          "name": "NEW event visibility — EMPLOYEE",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "// Create a second NEW event for visibility test",
              "pm.sendRequest({",
              "  url: pm.collectionVariables.get('baseUrl') + '/api/events',",
              "  method: 'POST',",
              "  header: { 'Content-Type': 'application/json' },",
              "  body: { mode: 'raw', raw: JSON.stringify({",
              "    organizerId: pm.collectionVariables.get('organizerId'),",
              "    fromTime: '2026-12-01T10:00:00',",
              "    toTime: '2026-12-01T12:00:00',",
              "    category: 'IT', nameEvent: 'Second NEW event'",
              "  })}",
              "}, (err, res) => {",
              "  if (!err && res.code === 201) pm.collectionVariables.set('newEventId', res.json().id);",
              "});"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const list = pm.response.json();",
              "const newIds = list.filter(e => e.eventStatus === 'NEW').map(e => e.id);",
              "pm.test('EMPLOYEE does not see NEW events', () => {",
              "  pm.expect(newIds).to.be.an('array').that.is.empty;",
              "});"
            ] } }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/events?actorId={{employeeId}}", "host": ["{{baseUrl}}"], "path": ["api", "events"], "query": [{ "key": "actorId", "value": "{{employeeId}}" }] }
          }
        },
        {
          "name": "NEW event visibility — HR sees NEW",
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const list = pm.response.json();",
              "const hasNew = list.some(e => e.eventStatus === 'NEW');",
              "pm.test('HR sees NEW events', () => pm.expect(hasNew).to.be.true);"
            ] } }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/events?actorId={{hrId}}", "host": ["{{baseUrl}}"], "path": ["api", "events"], "query": [{ "key": "actorId", "value": "{{hrId}}" }] }
          }
        }
      ]
    },

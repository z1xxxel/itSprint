    {
      "name": "06. History",
      "item": [
        {
          "name": "GET transactions for EMPLOYEE",
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const page = pm.response.json();",
              "pm.test('has content array', () => pm.expect(page.content).to.be.an('array'));",
              "pm.test('has at least 3 tx', () => pm.expect(page.content.length).to.be.at.least(3));",
              "const types = page.content.map(t => t.type);",
              "pm.test('contains MANAGER_BONUS', () => pm.expect(types).to.include('MANAGER_BONUS'));",
              "pm.test('contains ADMIN_ADJUSTMENT', () => pm.expect(types).to.include('ADMIN_ADJUSTMENT'));",
              "pm.test('has comment on each', () => page.content.forEach(t => pm.expect(t.comment).to.not.be.null));"
            ] } }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/{{employeeId}}/transactions?page=0&size=20", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{employeeId}}", "transactions"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "20" }] }
          }
        },
        {
          "name": "Capture balance BEFORE award",
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('balanceBeforeAward', pm.response.json().balance);"
            ] } }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/{{employeeId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{employeeId}}"] }
          }
        }
      ]
    },
    {
      "name": "07. Completion & Award (slow)",
      "item": [
        {
          "name": "Create event with toTime = now+5s",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const now = Date.now();",
              "const fmt = (ms) => new Date(ms).toISOString().slice(0, 19);",
              "pm.collectionVariables.set('fastFrom', fmt(now + 2000));",
              "pm.collectionVariables.set('fastTo', fmt(now + 5000));"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('fastEventId', pm.response.json().id);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"organizerId\": {{organizerId}},\n  \"fromTime\": \"{{fastFrom}}\",\n  \"toTime\": \"{{fastTo}}\",\n  \"category\": \"IT\",\n  \"nameEvent\": \"Fast Completion Test\",\n  \"paidInCoins\": true,\n  \"rewardCoins\": 100.00,\n  \"rewardRating\": 5.0\n}" },
            "url": { "raw": "{{baseUrl}}/api/events", "host": ["{{baseUrl}}"], "path": ["api", "events"] }
          }
        },
        {
          "name": "Assign fast event (HR)",
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('200 ASSIGNED', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().eventStatus).to.eql('ASSIGNED');",
              "});"
            ] } }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"actorId\": {{hrId}}\n}" },
            "url": { "raw": "{{baseUrl}}/api/events/{{fastEventId}}/assign", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{fastEventId}}", "assign"] }
          }
        },
        {
          "name": "Register EMPLOYEE on fast event",
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('201 registered', () => pm.response.to.have.status(201));"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": {{employeeId}}\n}" },
            "url": { "raw": "{{baseUrl}}/api/events/{{fastEventId}}/participants", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{fastEventId}}", "participants"] }
          }
        },
        {
          "name": "WAIT for scheduler (~40s)",
          "event": [
            { "listen": "test", "script": { "exec": [
              "// Block this test for 40s — scheduler interval is 30s",
              "const start = Date.now();",
              "while (Date.now() - start < 40000) { /* busy wait */ }",
              "pm.test('waited 40s', () => pm.expect(true).to.be.true);"
            ] } }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "Check: event COMPLETED, balance increased",
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const user = pm.response.json();",
              "const before = parseFloat(pm.collectionVariables.get('balanceBeforeAward'));",
              "const after = parseFloat(user.balance);",
              "pm.test('balance increased by 100', () => pm.expect(after - before).to.eql(100));",
              "pm.test('rating increased by 5', () => pm.expect(user.rating).to.eql(5.0));"
            ] } }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/{{employeeId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{employeeId}}"] }
          }
        },
        {
          "name": "Idempotency: balance not double-awarded",
          "event": [
            { "listen": "test", "script": { "exec": [
              "// Wait another 40s for another scheduler cycle",
              "const start = Date.now();",
              "while (Date.now() - start < 40000) {}",
              "pm.test('second wait done', () => pm.expect(true).to.be.true);"
            ] } }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "Check: no double award",
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const user = pm.response.json();",
              "const before = parseFloat(pm.collectionVariables.get('balanceBeforeAward'));",
              "const after = parseFloat(user.balance);",
              "pm.test('balance still +100 (idempotent)', () => pm.expect(after - before).to.eql(100));"
            ] } }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/{{employeeId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{employeeId}}"] }
          }
        }
      ]
    }
  ]
}
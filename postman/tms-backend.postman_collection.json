            ] } }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/events/{{eventId}}/participants", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{eventId}}", "participants"] }
          }
        }
      ]
    },
    {
      "name": "04. Transfers & Limits",
      "item": [
        {
          "name": "Transfer 30 EMPLOYEE → MANAGER (ok)",
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('type=PEER_THANKS', () => pm.expect(b.type).to.eql('PEER_THANKS'));",
